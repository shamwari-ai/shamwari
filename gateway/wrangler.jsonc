{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shamwari-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Query strings are redacted: /callback carries the OAuth code and state, and
  // /lite/?signin=failed carries a reason; persisted invocation logs must never store them.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": true },
  },

  // Embeddings only. Also the last-resort inference fallback.
  "ai": { "binding": "AI" },

  "kv_namespaces": [
    // Created 2026-10-21 as "shamwari-gateway-AUTH_CACHE" in the Nyuchi Web
    // Services account. A namespace id is not a credential.
    { "binding": "AUTH_CACHE", "id": "aef87f10881e4ba99f68045026ce18b1" },
  ],

  // STOPGAP (2026-11-12): SHAMWARI_AI_TOKEN (stored 2026-10-22) is rejected by the AI Gateway (401 on every
  // request in production; no live Cloudflare token matches it), so this binds the existing, correctly
  // scoped NYUCHI_AI_GATEWAY_TOKEN (AI Gateway Run + Workers AI Read, an account token that works for the
  // `shamwari` gateway). Replace it with a dedicated, Shamwari-only token and point this back at
  // SHAMWARI_AI_TOKEN; creating or rotating that token is an owner action (#83).
  // The AI Gateway authentication token lives in the account's Secrets Store and is bound here, so no copy of it sits in the
  // Worker's own secrets. Creating or rotating it is a Secrets Store action.
  "secrets_store_secrets": [
    {
      "binding": "CF_AIG_TOKEN",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "NYUCHI_AI_GATEWAY_TOKEN",
    },
    // The Nyuchi API key pair (an internal key scoped shamwari, shamwari:service and ai). Core holds NO
    // standing key: this Worker trades the pair for a short-lived token at POST /v1/auth/token and sends
    // it to Core on each request (src/api-token.ts). Owner steps: docs/core-fly-runbook.md, "The API
    // credential". The two secrets must EXIST in the store before this deploys.
    {
      "binding": "SHAMWARI_API_CLIENT_ID",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "SHAMWARI_API_CLIENT_ID",
    },
    {
      "binding": "SHAMWARI_API_CLIENT_SECRET",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "SHAMWARI_API_CLIENT_SECRET",
    },
  ],

  // Weekly degradation probe. Exercises all three inference paths and writes
  // the reading to platform.serviceHealth. This replaces "break the Gateway
  // credential deliberately once a month" — a manual chore, which will be
  // skipped, and skipping it looks exactly like passing it.
  // Mondays 06:00 UTC (08:00 CAT), ahead of the week's traffic.
  //
  // Three small completions a week. If that cost ever matters, the fallback
  // paths are not being relied on enough to be worth keeping.
  "triggers": { "crons": ["0 6 * * 1"] },

  "queues": {
    "producers": [{ "binding": "SINK", "queue": "shamwari-sink" }],
    "consumers": [
      {
        "queue": "shamwari-sink",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "shamwari-sink-dlq",
      },
    ],
  },

  "vars": {
    // Not secrets: an account id and a route name identify, they do not
    // authorise. `wrangler deploy` replaces vars, so they live here and not
    // only in the dashboard.
    "CF_ACCOUNT_ID": "125a2dfbc21f76a25c980609609e8218",
    "CF_GATEWAY_ID": "shamwari",
    "CF_ROUTE_NAME": "shamwari",
    // Core's Fly address (docs/core-fly-runbook.md, "Point the Worker at Core"). The
    // core.shamwari.ai name was never created; the Fly hostname needs no DNS of ours.
    "CORE_URL": "https://shamwari-core.fly.dev",
    // Where the API key pair is exchanged for the short-lived token Core is handed (src/api-token.ts).
    "NYUCHI_API_URL": "https://api.nyuchi.com",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "GROUND_TOP_K": "6",
    "AUTH_CACHE_TTL": "60",
    // Browser origins that may call the chat endpoint (src/cors.ts): the Shamwari
    // Chat web app. Exact match, never "*".
    "CORS_ORIGINS": "https://shamwari.ai",
    // Workers AI model ids, billed through Cloudflare; there is no Z.ai API
    // and no provider key. See docs/workers-ai-models.md. These are the
    // intended models; dynamic-route.json decides what actually answers.
    "ECONOMY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "STANDARD_MODEL": "@cf/zai-org/glm-5.3",
    "SURFACE": "shamwari.ai",

    // Gates /v1/ground/context, the retrieval-only endpoint Mind calls.
    // It does NOT gate /v1/chat/completions: that endpoint generates on
    // Cloud, so no value here can make it serve personal scope. Flipping
    // this used to unlock exactly that, which is the leak scope.ts now
    // documents. Keep it in vars, not secrets — it is not a credential and
    // a plaintext value is what makes it auditable in `wrangler deploy`
    // output and in the /health response.
    "MIND_AVAILABLE": "false",

    // Moves API-key verification and usage metering from Core to the Nyuchi
    // Servers API. Off until that service exists and the owner says so. When
    // on, set SERVERS_API_URL here and SERVERS_API_TOKEN as a secret. Contract:
    // docs/servers-api-contract.md. If on but unconfigured, auth fails closed.
    "SERVERS_API_ENABLED": "false",

    // WorkOS sign-in for people (docs/chat-signin.md). None of these is a secret. The
    // client_id check is what keeps tokens minted for any other Mukoko app out; `aud` is deliberately NOT set (the
    // production JWT template carries none; setting it would make every token without it fail). Two applications
    // are accepted, comma separated, and no others: Shamwari Chat (the mobile app) and Mukoko Account (the light
    // chat at /lite/, which signs in there because Shamwari Chat has no API key for the Worker's code exchange).
    // The JWKS URL is built from the first id; WorkOS signs every application of an environment with the same keys.
    "WORKOS_CLIENT_ID": "client_01M68PCT0T5ECHKDYH45ECT0GV,client_01KQBBSMQTSMTBN7HEC9KQBJC0",
    // The issuers a token may carry. NONE of these has been read off a real access token yet; the choice rests on the
    // owner's statement that auth.mukoko.com is the WorkOS API (custom API domain) of the Mukoko Account environment and
    // accounts.mukoko.com its hosted AuthKit/OIDC domain, and on WorkOS's per-client path form
    // (<domain>/user_management/<client_id>). The WorkOS docs pages could not be read from here, so no doc line is cited.
    // If every token is refused, Workers Logs has a "workos token refused: claim=iss iss=..." line with the real value.
    // The signature (JWKS), client_id and exp stay required whatever the issuer. A trailing slash is tolerated.
    "WORKOS_ISSUER": "https://auth.mukoko.com,https://auth.mukoko.com/user_management/client_01KQBBSMQTSMTBN7HEC9KQBJC0,https://accounts.mukoko.com,https://accounts.mukoko.com/user_management/client_01KQBBSMQTSMTBN7HEC9KQBJC0",
    // Tokens per person per month. About $0.20 at the economy model's blended price (pricing.json:
    // 85% input at $0.15/M, 15% output at $0.50/M is about $0.20/M, so 1M tokens), the unit-cost
    // target in docs/tiered-access-design.md. An estimate; the owner's number replaces it.
    "WORKOS_MONTHLY_TOKEN_CAP": "1000000",
  },

  // api.shamwari.ai is this Worker. A custom domain creates its own DNS record and
  // certificate; it needs the shamwari.ai zone in this account (the marketing site already
  // holds shamwari.ai and www.shamwari.ai here).
  "routes": [{ "pattern": "api.shamwari.ai", "custom_domain": true }],

  // wrangler secret put:
  //   SHAMWARI_CORE_TOKEN shared with Core
  //   SERVERS_API_TOKEN   only when SERVERS_API_ENABLED is true
  //   SERVERS_API_INTERNAL_KEY  likewise (x-nyuchi-internal-key second factor)
}
