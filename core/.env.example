# --- read by the running service (Fly secrets; see docs/core-fly-runbook.md) ---
SHAMWARI_CORE_TOKEN=
# Core's one credential for the Nyuchi API: an internal key scoped shamwari, shamwari:service, ai.
# Form: nyk_<id>.nys_<secret>. Minted in the Console.
NYUCHI_API_INTERNAL_KEY=
# Operator routes (a different secret from the Worker's).
SHAMWARI_OPS_TOKEN=
# Not secrets; fly.toml sets these. Override only to point at another API.
NYUCHI_API_URL=http://nyuchi-api.internal:8080
NYUCHI_API_HOST=api.nyuchi.com

# --- ingest_ground.py ONLY: set in your own shell, never on the Fly app ---
SUPABASE_DB_URL=
MONGODB_URI=
CF_ACCOUNT_ID=
CF_API_TOKEN=
