{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shamwari-app",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Shamwari Chat: the PWA, its service worker, manifest and headers (static
  // output of `npm run build:app`), plus the SESSION WORKER (worker/) that does
  // sign-in and the gate in front of the chat. The root / is answered by the Worker (worker/root.ts): a 302 to /chat/ or /lite/
  // by connection quality, never a static redirect.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist-app",
    // The Worker is the gate: it runs first for the root, everything under /lite/ and the build output in
    // /_astro/, and serves the static asset only to someone signed in (worker/gate.ts). The ASSETS binding
    // is how it reads them. Only the favicon and apple-touch icon are served without it.
    "binding": "ASSETS",
    "run_worker_first": ["/", "/lite/*", "/_astro/*"],
  },

  // Public configuration, safe in git. The client id is NOT a secret.
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M68PCT0T5ECHKDYH45ECT0GV",
    "WORKOS_REDIRECT_URI": "https://shamwari.ai/lite/callback",
    // The root sends everyone to /lite/ until the main chat answers at /chat/ (worker/root.ts).
    // Set to "true" in the same change that makes /chat/ live.
    "CHAT_LIVE": "false",
  },

  // One instance per WorkOS session id. Refresh tokens are single-use, so every
  // refresh for a session passes through one place (worker/coordinator.ts).
  "durable_objects": {
    "bindings": [{ "name": "SESSION_REFRESH", "class_name": "SessionRefresh" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRefresh"] }],

  // SECRETS, by name only. Both live in the account's Secrets Store (`default_secrets_store`); no value is
  // ever in this file or in git. WORKOS_API_KEY is the Mukoko Account WorkOS environment's API key and
  // COOKIE_PASSWORD (at least 32 characters) seals the session cookie. Every Mukoko app signs in through
  // that one environment (owner, 2026-11-11), so these are the shared Mukoko secrets, not new ones.
  // Until both resolve the auth routes answer 503 and the page stays on its developer-key mode. For local
  // runs only, put both in .dev.vars (git-ignored).
  "secrets_store_secrets": [
    {
      "binding": "WORKOS_API_KEY",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "CONSOLE_WORKOS_API_KEY",
    },
    {
      "binding": "COOKIE_PASSWORD",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "SESSION_SECRET",
    },
  ],

  // Reachable on https://shamwari-app.nyuchi.workers.dev as soon as it is deployed.
  "workers_dev": true,

  // The apex https://shamwari.ai is this Worker's (moved from `shamwari-site` on 2026-11-11 with the
  // Workers custom-domains API, override_existing_origin). It is declared here so a deploy keeps it
  // rather than releasing it; `shamwari-site` no longer declares it.
  "routes": [{ "pattern": "shamwari.ai", "custom_domain": true }],
}
