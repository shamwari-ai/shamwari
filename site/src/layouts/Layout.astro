---
import '../styles/global.css';
import DiscoverShell from '@bundu/ui/discover/DiscoverShell.astro';
import Breadcrumb from '@bundu/ui/Breadcrumb.astro';
import SocialIcon from '@bundu/ui/SocialIcon.astro';
import { Button } from '@bundu/ui/ui/button';
import { deriveBreadcrumbs } from '@bundu/ui';
import { BREADCRUMB_LABELS, PAGES, REPO, CONTACT_EMAIL } from '../lib/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const crumbs = deriveBreadcrumbs(Astro.url.pathname, BREADCRUMB_LABELS, 'Shamwari');

// Home is the brand link and Contact is the header action, so neither is
// repeated in the nav; Contact has its own column in the footer.
const path = Astro.url.pathname;
const current = (href: string) => !href.startsWith('http') && href !== '/' && path.startsWith(href);
const nav = PAGES.filter((p) => p.path !== '/' && p.path !== '/contact/').map((p) => ({
  label: p.label,
  href: p.path,
  current: current(p.path),
}));
const footerLinks = nav;
const year = new Date().getFullYear();

// One social-preview image per page, generated at design time (see
// "Brand assets" in README.md) rather than at request time — this is a
// static site, so there's no server to render one per request. The slug
// maps 1:1 onto the route: '/' -> og/home.png, '/blueprint/' -> og/blueprint.png.
const slug = Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.replaceAll('/', '');
const ogImage = new URL(`/og/${slug}.png`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shamwari AI" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
  />
</head>
<body class="bg-canvas text-foreground">
  <DiscoverShell
    homeLabel="Shamwari AI, home"
    nav={nav}
    footerLinks={footerLinks}
    footerNote={`© ${year} Bundu Foundation. All rights reserved. Shamwari is Shona for friend. Bundu Foundation intellectual property, sold commercially under Nyuchi Africa. Platform code is Apache-2.0. Third-party model and corpus terms are recorded separately.`}
  >
    <span slot="brand" class="flex items-baseline gap-2 font-serif text-h4 font-semibold text-primary">
      Shamwari
      <span class="font-sans text-caption font-semibold uppercase tracking-widest text-muted-foreground">AI</span>
    </span>
    <Button slot="action" href="/contact/" size="sm">Get in touch</Button>

    {crumbs.length >= 2 && (
      <div class="container-custom pt-6">
        <Breadcrumb items={crumbs} origin={Astro.site?.toString()} />
      </div>
    )}
    <slot />

    <div slot="footer">
      <p class="max-w-xs text-body-sm text-muted-foreground">
        An AI companion built in Zimbabwe. Community pillar of the Bundu Ecosystem.
      </p>
      <div class="mt-4 flex gap-1">
        <SocialIcon url={REPO} label="Shamwari on GitHub" />
      </div>
    </div>
    <div slot="footer" class="text-body-sm">
      <p class="eyebrow mb-2 block">Ecosystem</p>
      <ul class="space-y-1 text-muted-foreground">
        <li><a href="https://bundu.org" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center no-underline hover:text-foreground">Bundu Foundation</a></li>
        <li><a href="https://nyuchi.com" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center no-underline hover:text-foreground">Nyuchi Africa</a></li>
        <li class="flex min-h-11 items-center">Mukoko</li>
      </ul>
      <p class="eyebrow mb-2 mt-6 block">Get in touch</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-foreground">{CONTACT_EMAIL}</a>
    </div>
  </DiscoverShell>
</body>
</html>
