---
import '../styles/global.css';
import MineralStrip from '@bundu/ui/MineralStrip.astro';
import Breadcrumb from '@bundu/ui/Breadcrumb.astro';
import { deriveBreadcrumbs } from '@bundu/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BREADCRUMB_LABELS } from '../lib/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const crumbs = deriveBreadcrumbs(Astro.url.pathname, BREADCRUMB_LABELS, 'Shamwari');

// One social-preview image per page, generated at design time (see
// "Brand assets" in README.md) rather than at request time — this is a
// static site, so there's no server to render one per request. The slug
// maps 1:1 onto the route: '/' -> og/home.png, '/blueprint/' -> og/blueprint.png.
const slug = Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.replaceAll('/', '');
const ogImage = new URL(`/og/${slug}.png`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shamwari AI" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
  />
</head>
<body class="bg-canvas text-foreground">
  <MineralStrip />
  <Header />
  <main>
    {crumbs.length >= 2 && (
      <div class="container-custom pt-6">
        <Breadcrumb items={crumbs} origin={Astro.site?.toString()} />
      </div>
    )}
    <slot />
  </main>
  <Footer />
</body>
</html>
