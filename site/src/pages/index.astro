---
import Layout from '../layouts/Layout.astro';
import Hero from '@bundu/ui/Hero.astro';
import Section from '@bundu/ui/Section.astro';
import SectionHeader from '@bundu/ui/SectionHeader.astro';
import { Button } from '@bundu/ui/ui/button';
import { Card } from '@bundu/ui/ui/card';
import StatusPill from '../components/StatusPill.astro';
import DataScopes from '../components/DataScopes.astro';
import { STATUS } from '../data/status';
// The hero's right-hand panel, in the way nyuchi.com lists what it runs:
// the five products, each with its honest state. The state is read from the
// one STATUS list that /project/ also renders, so the two cannot disagree.
const stateOf = (title: string) => {
  const item = STATUS.find((s) => s.title === title);
  if (!item) throw new Error(`hero panel: no STATUS item titled "${title}"`);
  return item.state;
};
const panel = [
  { name: 'Chat', title: 'Shamwari Chat', note: 'Ask in Shona, Ndebele or English, with the source cited' },
  { name: 'CLI', title: 'Shamwari CLI', note: 'Shamwari in your terminal' },
  { name: 'Factory', title: 'Shamwari Factory', note: 'The coding agent, working in your GitHub repositories, for paying customers' },
  { name: 'MCP', title: 'Shamwari MCP server', note: 'Connect Shamwari to your own agents and tools' },
  { name: 'API', title: 'Shamwari API', note: 'An OpenAI-style API, pay as you go' },
].map((p) => ({ ...p, state: stateOf(p.title) }));
---
<Layout
  title="Shamwari AI — an African AI companion that cites its sources"
  description="Shamwari is an AI companion built in Zimbabwe. It answers in Shona, Ndebele and English, cites the actual statute instead of guessing, and is built so your personal data can never reach a cloud model."
>
  <Hero
    subtitle="Community pillar of the Bundu Ecosystem"
    title="A friend that serves; a friend that does not control."
    description="For Zimbabweans who need the current law or tax rule, in Shona, Ndebele or English. Shamwari is being built to look up the actual provision and show you where it came from. It runs on open-weights models, and it is built so that what it knows about you stays on your own device (Shamwari Mind) and the cloud model never sees it."
    primaryCTA={{ text: 'Talk to us', href: '/contact/' }}
    secondaryCTA={{ text: 'See where things stand', href: '/project/' }}
    variant="showcase"
    layout="split"
  >
    <Card slot="media" class="w-full max-w-md lg:ml-auto">
      <div class="flex items-center gap-3 border-b border-border pb-4">
        <svg viewBox="0 0 32 32" width="32" height="32" class="h-8 w-8" aria-hidden="true" focusable="false">
          <rect width="32" height="32" rx="7" fill="var(--primary)" />
          <path d="M9 21c0-6 3-10 7-10s7 4 7 10" fill="none" stroke="var(--primary-foreground)" stroke-width="2.4" stroke-linecap="round" />
          <circle cx="16" cy="21.5" r="1.8" fill="var(--primary-foreground)" />
        </svg>
        <p class="eyebrow !mb-0">The five products</p>
      </div>
      <p class="pt-4 text-body-sm text-muted-foreground">
        One companion, five ways in. Each is labelled with where it honestly stands.
      </p>
      <ul class="divide-y divide-border">
        {panel.map((row) => (
          <li class="flex items-start justify-between gap-4 py-4">
            <div class="min-w-0">
              <p class="font-serif text-h5 text-foreground">
                {row.name}
              </p>
              <p class="mt-1 text-body-sm text-muted-foreground">{row.note}</p>
            </div>
            <StatusPill state={row.state} />
          </li>
        ))}
      </ul>
    </Card>
  </Hero>

  <Section bg="secondary" space="tight" border>
    <div class="max-w-2xl mx-auto">
      <blockquote class="border-l-2 border-primary pl-5 font-serif text-h3 italic text-primary">
        Shamwari cites the Statutory Instrument. ChatGPT guesses.
      </blockquote>
      <p class="mt-5 text-body text-muted-foreground">
        Zimbabwean law, tax thresholds and monetary policy change most months. A
        model with that baked into its weights is stale the day it ships — and
        it will answer confidently anyway. Shamwari retrieves the current text
        before it answers and shows you where it came from.
      </p>
    </div>
  </Section>

  <Section space="loose">
    <SectionHeader
      eyebrow="Where your data goes"
      title="Your own data goes to your device, and nowhere else"
      description="Shamwari sorts every question into one of three scopes before anything leaves. Personal data is only ever handled by Mind, on your device. If a personal question is headed for the cloud, Shamwari refuses it instead of quietly answering a different question. Mind, the on-device part, is still being built, and until it ships a personal question is refused rather than sent anywhere else."
      max="max-w-2xl"
    />
    <div class="mt-8">
      <DataScopes />
    </div>
  </Section>

  <Section space="loose">
    <SectionHeader
      align="center"
      eyebrow="Get in touch"
      title="Talk to us before you talk to a consultant"
      description="We're bringing on the first customers by hand, mostly around Zimbabwean tax and regulatory compliance."
      max="max-w-xl"
    />
    <div class="mt-8 flex justify-center">
      <Button href="/contact/" size="lg" arrow>Get in touch</Button>
    </div>
  </Section>
</Layout>
