---
import Layout from '../layouts/Layout.astro';
import Hero from '@bundu/ui/Hero.astro';
import Section from '@bundu/ui/Section.astro';
import SectionHeader from '@bundu/ui/SectionHeader.astro';
import { Button } from '@bundu/ui/ui/button';
import { Card } from '@bundu/ui/ui/card';
import StatusPill from '../components/StatusPill.astro';
import DataScopes from '../components/DataScopes.astro';
import NumberBadge from '../components/NumberBadge.astro';
import { CORPUS_LAST_CHECKED, STATUS } from '../data/status';
// The hero's right-hand panel, in the way nyuchi.com lists what it runs:
// the five products, each with its honest state. The state is read from the
// one STATUS list that /project/ also renders, so the two cannot disagree.
const stateOf = (title: string) => {
  const item = STATUS.find((s) => s.title === title);
  if (!item) throw new Error(`hero panel: no STATUS item titled "${title}"`);
  return item.state;
};
const panel = [
  { name: 'Chat', title: 'Shamwari Chat', note: 'Ask in English, Shona or Ndebele, with the source cited' },
  { name: 'CLI', title: 'Shamwari CLI', note: 'Shamwari in your terminal' },
  { name: 'Factory', title: 'Shamwari Factory', note: 'The coding agent, working in your GitHub repositories, for paying customers' },
  { name: 'MCP', title: 'Shamwari MCP server', note: 'Connect Shamwari to your own agents and tools' },
  { name: 'API', title: 'Shamwari API', note: 'An OpenAI-style API, pay as you go' },
].map((p) => ({ ...p, state: stateOf(p.title) }));
const steps = [
  { title: 'You ask', body: 'In English, Shona or Ndebele, on a phone, on a slow connection. The app is built for weak networks and keeps a question you wrote offline until it can send it.' },
  { title: 'Shamwari finds the source', body: 'It looks the question up in Ground, the library of sources we have the right to use, before it answers. A question about you, your own data, is never sent to a cloud model: it is refused.' },
  { title: 'You get the answer and its source', body: 'The answer comes with the document and section it was taken from, or says plainly that it could not find one. It is not legal advice.' },
];
const phases = [
  { when: 'First', title: 'Farming information', body: 'Weather, market prices and extension material from sources Nyuchi owns or that are licence-clean, with no personal data in them.' },
  { when: 'Second', title: 'The Constitution of Zimbabwe', body: 'Public, foundational and approved. The first place a legal answer can be traced to its section.' },
  { when: 'After that', title: 'Law and tax', body: 'Once the Acts have a licence we can use. Some free legal libraries do not allow commercial use, so we ask first and wait for a yes.' },
];
---
<Layout
  title="Shamwari AI — an African AI companion that shows its sources"
  description="Shamwari is an AI companion built in Zimbabwe. It is built to answer in English, Shona and Ndebele, to show where every answer came from, and to keep your personal data away from any cloud model."
>
  <Hero
    subtitle="Community pillar of the Bundu Ecosystem"
    title="A friend that serves; a friend that does not control."
    description="For farmers, small businesses and anyone in Zimbabwe who needs an answer they can check, in English, Shona or Ndebele. Shamwari is being built to find the source, answer from it, and show you where it came from. It starts with farming information and the Constitution; law and tax follow once we have the right to use the sources. It runs on open-weights models, and it is built so that what it knows about you stays on your own device (Shamwari Mind) and the cloud model never sees it."
    primaryCTA={{ text: 'Talk to us', href: '/contact/' }}
    secondaryCTA={{ text: 'See where things stand', href: '/project/' }}
    variant="showcase"
    layout="split"
  >
    <Card slot="media" class="w-full max-w-md lg:ml-auto">
      <div class="flex items-center gap-3 border-b border-border pb-4">
        <svg viewBox="0 0 32 32" width="32" height="32" class="h-8 w-8" aria-hidden="true" focusable="false">
          <rect width="32" height="32" rx="7" fill="var(--primary)" />
          <path d="M9 21c0-6 3-10 7-10s7 4 7 10" fill="none" stroke="var(--primary-foreground)" stroke-width="2.4" stroke-linecap="round" />
          <circle cx="16" cy="21.5" r="1.8" fill="var(--primary-foreground)" />
        </svg>
        <p class="eyebrow !mb-0">The five products</p>
      </div>
      <p class="pt-4 text-body-sm text-muted-foreground">
        One companion, five ways in. Each is labelled with where it honestly stands.
      </p>
      <ul class="divide-y divide-border">
        {panel.map((row) => (
          <li class="flex items-start justify-between gap-4 py-4">
            <div class="min-w-0">
              <p class="font-serif text-h5 text-foreground">
                {row.name}
              </p>
              <p class="mt-1 text-body-sm text-muted-foreground">{row.note}</p>
            </div>
            <StatusPill state={row.state} />
          </li>
        ))}
      </ul>
    </Card>
  </Hero>

  <Section bg="secondary" border>
    <SectionHeader
      eyebrow="How an answer is built"
      title="Every answer shows where it came from"
      description="A model that has only memorised the world goes stale, and it answers confidently anyway. Shamwari is built to read first and answer second, and to tell you when it could not find a source."
      max="max-w-2xl"
    />
    <ol class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {steps.map((step, i) => (
        <li>
          <Card padding="lg" class="h-full">
            <NumberBadge n={i + 1} />
            <h3 class="mt-4 font-serif text-h4 text-foreground">{step.title}</h3>
            <p class="mt-2 text-body-sm text-muted-foreground">{step.body}</p>
          </Card>
        </li>
      ))}
    </ol>
  </Section>

  <Section space="loose">
    <SectionHeader
      eyebrow="What it starts with"
      title="One trusted source at a time"
      description={`We use what we have the right to use, and we say so. Nothing is scraped first and asked about later. When we last checked, on ${CORPUS_LAST_CHECKED}, no source was loaded, so Shamwari cannot cite a real one yet; this is the order we are building it in.`}
      max="max-w-2xl"
    />
    <ol class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {phases.map((ph) => (
        <li>
          <Card padding="lg" class="h-full">
            <p class="eyebrow !mb-2">{ph.when}</p>
            <h3 class="font-serif text-h4 text-foreground">{ph.title}</h3>
            <p class="mt-2 text-body-sm text-muted-foreground">{ph.body}</p>
          </Card>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-body-sm">
      <a href="/project/" class="text-primary underline underline-offset-2">See where every piece stands →</a>
    </p>
  </Section>

  <Section space="loose">
    <SectionHeader
      eyebrow="Where your data goes"
      title="Your own data goes to your device, and nowhere else"
      description="Shamwari sorts every question into one of three scopes before anything leaves. Personal data is only ever handled by Mind, on your device. If a personal question is headed for the cloud, Shamwari refuses it instead of quietly answering a different question. Mind, the on-device part, is still being built, and until it ships a personal question is refused rather than sent anywhere else."
      max="max-w-2xl"
    />
    <div class="mt-8">
      <DataScopes />
    </div>
  </Section>

  <Section space="loose">
    <SectionHeader
      align="center"
      eyebrow="Get in touch"
      title="Talk to us before you talk to a consultant"
      description="We're bringing on the first customers by hand. If you work in farming or in compliance and need answers you can check, tell us what you need."
      max="max-w-xl"
    />
    <div class="mt-8 flex justify-center">
      <Button href="/contact/" size="lg" arrow>Get in touch</Button>
    </div>
  </Section>
</Layout>
