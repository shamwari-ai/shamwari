{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shamwari-site",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Astro's static output. No Worker script, no bindings, no secrets.
  "assets": { "directory": "./dist" },

  // MARKETING ONLY. The chat app is a separate Worker (wrangler.app.jsonc,
  // `shamwari-app`) on the apex https://shamwari.ai. This one is expected on
  // https://www.shamwari.ai and nothing else. workers_dev gives a preview URL:
  // https://shamwari-site.nyuchi.workers.dev
  "workers_dev": true,

  "routes": [{ "pattern": "www.shamwari.ai", "custom_domain": true }],
}
