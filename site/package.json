{
  "name": "shamwari-site",
  "version": "1.0.0",
  "private": true,
  "description": "shamwari.ai — the public landing page",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:app": "astro dev --config astro.app.config.mjs",
    "build": "astro build",
    "build:app": "astro build --config astro.app.config.mjs --outDir dist-app && node scripts/post-build.mjs dist-app",
    "preview": "wrangler dev",
    "preview:app": "wrangler dev --config app/wrangler.jsonc",
    "check": "astro check && node check.mjs marketing",
    "check:app": "node check.mjs app",
    "deploy": "npm run build && wrangler deploy",
    "deploy:app": "npm run build:app && wrangler deploy --config app/wrangler.jsonc",
    "test": "vitest run",
    "test:site": "vitest run test/site",
    "test:app": "vitest run test/app test/worker",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@bundu/ui": "^0.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@workos-inc/node": "^12.4.0",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
