---
// Shamwari Chat: the R1 chat app and R2 Lite PWA from shamwari-ai/shamwari#83.
//
// This page belongs to the APP Worker (shamwari-app, https://shamwari.ai/chat/, the chat), built by
// astro.app.config.mjs from app-src/. The marketing Worker (shamwari-site, https://www.shamwari.ai) never contains it.
//
// The frame is drawn here in plain HTML (issue #329: modelled on OpenCode's web app, dense and text first): a thin
// session list on the left (a slide-over below 64rem), a small top bar with the chat's title and a few icon actions, one
// reading column, and one prompt box docked at the bottom. The data-slot names are Mzizi's AppShell's, so the tests and
// the script that knew that frame still find its parts. No web fonts, no Tailwind, and the only client JS on the site.
// The page is complete English HTML without JavaScript; the script translates it and runs the chat. Comments are Astro
// comments, so none of them ship.
import '../../../src/chat/chat.css';
import { en } from '../../../src/chat/strings';
import { authModeOf } from '../../../src/chat/auth-mode';
import { skillsEnabled } from '../../../src/chat/features';
import Icon from '@bundu/ui/Icon.astro';

// Fixed at build time and never read from the URL (see chat/main.ts).
const api = import.meta.env.PUBLIC_SHAMWARI_API ?? 'https://api.shamwari.ai';
// Mukoko sign-in is the default; only a build that asks for PUBLIC_CHAT_AUTH=developer-key gets the developer-key screen
// (chat/auth-mode.ts). check.mjs fails a build that comes out in any other mode.
const authMode = authModeOf(import.meta.env.PUBLIC_CHAT_AUTH);
// The Skills tab: Agent Skills read from and written as SKILL.md (chat/skill.ts), with a builder (chat/skills-ui.ts). On by
// default; a build with PUBLIC_CHAT_SKILLS=false leaves it out, and Plugins goes back to a "Coming soon" row (chat/features.ts).
const showSkills = skillsEnabled(import.meta.env.PUBLIC_CHAT_SKILLS);
---
<!doctype html>
<html lang="en" class="app">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
  <title>Shamwari Chat</title>
  <meta name="description" content="Ask in Shona, Ndebele or English about farming, weather, news and places, and get the answer with its source." />
  <link rel="canonical" href="https://shamwari.ai/chat/" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/png" href="/favicon.png" sizes="256x256" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/* The browser bar takes the page's own colour in each scheme (the page background token). */}
  <meta name="theme-color" content="#f3f3f1" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e0d0c" media="(prefers-color-scheme: dark)" />
  <meta name="shamwari-api" content={api} />
  <meta name="shamwari-auth" content={authMode} />
  <link rel="manifest" href="/chat/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Shamwari" />
</head>
<body>
  <a class="skip" href="#q" data-i18n="skipToQuestion">Skip to the question box</a>
  <div data-slot="app-shell" id="chat">
  {/* The session list. Below 64rem a popover laid over the page (Escape and a tap outside close it); from 64rem a column
      that the top bar's panel button hides and shows. */}
  <aside id="chat-sidebar" popover aria-label={en.yourChats} data-slot="app-sidebar">
    <div class="side-head" data-slot="sidebar-head">
      <a href="/chat/" class="brand" aria-label="shamwari"><img src="/apple-touch-icon.png" alt="" width="20" height="20" /><span class="wordmark">shamwari</span></a>
      <button type="button" class="icon-btn side-close" popovertarget="chat-sidebar" popovertargetaction="hide" aria-label={en.closeChats}><Icon name="close" class="i" /></button>
    </div>
    <div class="chats" data-slot="sidebar-body">
      <ul class="side-list side-actions">
        <li><button type="button" id="side-new" class="side-row"><Icon name="plus" class="side-icon" /><span data-i18n="newChat">{en.newChat}</span></button></li>
        <li><button type="button" id="side-search" class="side-row" aria-expanded="false" aria-controls="side-filter-wrap"><Icon name="search" class="side-icon" /><span data-i18n="searchChats">{en.searchChats}</span></button></li>
        <li id="side-filter-wrap" hidden>
          <label class="sr-only" for="side-filter" data-i18n="searchChats">{en.searchChats}</label>
          <input id="side-filter" type="search" class="side-filter" autocomplete="off" data-i18n-attr="placeholder:searchChats" placeholder={en.searchChats} />
        </li>
      </ul>
      <nav class="side-primary" aria-label={en.sections} data-i18n-attr="aria-label:sections">
        <ul class="side-list">
          <li><button type="button" class="side-row" data-section="chat" aria-current="page"><Icon name="message" class="side-icon" /><span data-i18n="navChat">{en.navChat}</span></button></li>
          <li><button type="button" class="side-row" data-section="projects"><Icon name="layers" class="side-icon" /><span data-i18n="projects">{en.projects}</span></button></li>
          <li><span class="side-row side-disabled" aria-disabled="true"><Icon name="workflow" class="side-icon" /><span data-i18n="navFactory">{en.navFactory}</span><span class="side-chip" data-i18n="comingSoon">{en.comingSoon}</span></span></li>
          <li><button type="button" class="side-row" data-section="artifacts"><Icon name="clipboard" class="side-icon" /><span data-i18n="artifacts">{en.artifacts}</span></button></li>
          {showSkills
            ? (<li><button type="button" class="side-row" data-section="plugins"><Icon name="grid" class="side-icon" /><span data-i18n="navPlugins">{en.navPlugins}</span></button></li>)
            : (<li><span class="side-row side-disabled" aria-disabled="true"><Icon name="grid" class="side-icon" /><span data-i18n="navPlugins">{en.navPlugins}</span><span class="side-chip" data-i18n="comingSoon">{en.comingSoon}</span></span></li>)}
        </ul>
      </nav>
      {/* One chat's own menu in the list (its "..."): pin, project, delete. Inside the drawer, so opening it keeps the drawer open. */}
      <div id="row-menu" class="menu row-menu" popover role="group" aria-label={en.chatOptions} data-i18n-attr="aria-label:chatOptions">
        <button type="button" id="row-pin" class="btn" aria-pressed="false">{en.pin}</button>
        <label class="sr-only" for="row-project" data-i18n="project">{en.project}</label>
        <select id="row-project"></select>
        <button type="button" id="row-delete" class="btn danger" data-i18n="deleteChat">{en.deleteChat}</button>
      </div>
      <div class="side-scroll">
        <div data-panel="chat">
          <details id="side-pinned" class="side-group" open hidden>
            <summary class="chats-title"><span data-i18n="pinned">{en.pinned}</span><Icon name="chevron-down" class="chats-chev" /></summary>
            <ul id="pinned-list" class="side-list"></ul>
          </details>
          <details id="side-chats" class="side-group" open hidden>
            <summary class="chats-title"><span data-i18n="recents">{en.recents}</span><Icon name="chevron-down" class="chats-chev" /></summary>
            <div id="history"><ul id="history-list" class="side-list"></ul></div>
          </details>
          <p id="chats-empty" class="side-empty" data-i18n="chatsEmpty">{en.chatsEmpty}</p>
        </div>
        <div data-panel="projects" hidden>
          <section aria-labelledby="projects-title">
            <h2 id="projects-title" class="chats-title" data-i18n="projects">Projects</h2>
            <ul id="project-list" class="side-list"></ul>
            <button type="button" id="new-project" class="btn link" aria-expanded="false" aria-controls="project-form" data-i18n="newProject">New project</button>
            <form id="project-form" class="row side-form" autocomplete="off" hidden>
              <label class="sr-only" for="project-name" data-i18n="projectName">Project name</label>
              <input id="project-name" maxlength="60" data-i18n-attr="placeholder:projectName" placeholder="Project name" />
              <button type="submit" class="btn" data-i18n="createProject">Create project</button>
            </form>
          </section>
        </div>
        <div data-panel="artifacts" hidden>
          <section id="side-artifacts" aria-labelledby="artifacts-title" hidden>
            <h2 id="artifacts-title" class="chats-title" data-i18n="artifacts">Artifacts</h2>
            <ul id="artifact-list" class="side-list"></ul>
          </section>
          <p id="artifacts-empty" class="side-empty" data-i18n="artifactsEmpty">{en.artifactsEmpty}</p>
        </div>
        {/* Skills first: the person's Agent Skills, the builder, import and export (chat/skills-ui.ts fills the panel). Plugins
            and MCP have nothing behind them yet, and each says so. The scripts load only when this panel is first opened. */}
        <div data-panel="plugins" hidden>
          <div role="tablist" class="side-tabs" aria-label={en.navPlugins} data-i18n-attr="aria-label:navPlugins">
            {showSkills && (<button type="button" role="tab" id="tab-skills" aria-controls="tabpanel-skills" aria-selected="true" data-i18n="skillsTab">{en.skillsTab}</button>)}
            <button type="button" role="tab" id="tab-plugins" aria-controls="tabpanel-plugins" aria-selected={showSkills ? 'false' : 'true'} tabindex={showSkills ? '-1' : undefined} data-i18n="pluginsTab">{en.pluginsTab}</button>
            <button type="button" role="tab" id="tab-mcp" aria-controls="tabpanel-mcp" aria-selected="false" tabindex="-1" data-i18n="mcpTab">{en.mcpTab}</button>
          </div>
          {showSkills && (<div role="tabpanel" id="tabpanel-skills" aria-labelledby="tab-skills"><p class="side-empty" data-i18n="skillsEmpty">{en.skillsEmpty}</p></div>)}
          <div role="tabpanel" id="tabpanel-plugins" aria-labelledby="tab-plugins" hidden={showSkills}><p class="side-empty" data-i18n="pluginsEmpty">{en.pluginsEmpty}</p></div>
          <div role="tabpanel" id="tabpanel-mcp" aria-labelledby="tab-mcp" hidden><p class="side-empty" data-i18n="mcpEmpty">{en.mcpEmpty}</p></div>
          <p class="side-empty" data-i18n="thirdPartyNote">{en.thirdPartyNote}</p>
        </div>
      </div>
      {/* The account row: it opens Settings (language, offline mode, delete history, install, the disclaimer, the API, the version). */}
      <div class="side-foot">
        <nav class="side-nav" aria-label={en.settings} data-i18n-attr="aria-label:settings">
          <button type="button" id="open-settings" class="side-row side-account" aria-haspopup="dialog"><span class="avatar" aria-hidden="true"><Icon name="user" class="side-icon" /></span><span data-i18n="settings">{en.settings}</span><Icon name="chevrons-up-down" class="side-icon side-gear" /></button>
        </nav>
      </div>
    </div>
  </aside>

  <div data-slot="app-main">
    <header class="topbar" data-slot="app-topbar">
      <button type="button" class="icon-btn menu-btn" popovertarget="chat-sidebar" aria-label={en.openChats}><Icon name="panel-left" class="i" /></button>
      <button type="button" id="side-toggle" class="icon-btn side-toggle" aria-pressed="false" aria-controls="chat-sidebar" aria-label={en.collapseChats} data-i18n-attr="aria-label:collapseChats"><Icon name="panel-left" class="i" /></button>
      <a href="/chat/" class="brand" aria-label="shamwari"><img src="/apple-touch-icon.png" alt="" width="20" height="20" /><span class="wordmark">shamwari</span></a>
      {/* The chat's title (the page's one heading) and a quiet subtitle; the whole block is one button that opens the chat's menu. */}
      <div class="chat-head">
        <div class="chat-heading">
          <h1 id="chat-title" class="chat-title sr-only" data-i18n="appName">{en.appName}</h1>
          <p id="chat-sub" class="chat-sub" hidden><span id="chat-sub-text"></span></p>
          <button type="button" id="chat-title-hit" class="chat-hit" popovertarget="chat-tools" aria-haspopup="true" hidden data-i18n-attr="aria-label:chatOptions" aria-label={en.chatOptions}></button>
        </div>
        <button type="button" id="chat-menu" class="icon-btn" popovertarget="chat-tools" aria-haspopup="true" hidden data-i18n-attr="aria-label:chatOptions" aria-label={en.chatOptions}><Icon name="more" class="i" /></button>
      </div>
      <div class="bar-actions">
        <button type="button" id="open-palette" class="bar-action palette-btn" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K"><Icon name="terminal" class="i" /><span class="sr-only" data-i18n="commands">{en.commands}</span><kbd class="kbd" aria-hidden="true">Ctrl K</kbd></button>
        <button type="button" id="offline-badge" class="bar-action offline-badge" hidden><Icon name="globe" class="i" /><span class="sr-only bar-label" data-i18n="offlineMode">{en.offlineMode}</span></button>
        <span id="new-chat" class="contents"><button type="button" class="bar-action"><Icon name="plus" class="i" /><span class="sr-only bar-label" data-i18n="newChat">New chat</span></button></span>
      </div>
    </header>

    {/* The open chat's tools: pin it, file it in a project, delete it. A popover opened from the title or its "...". */}
    <div id="chat-tools" class="menu" popover role="group" aria-labelledby="chat-tools-title" hidden>
      <h2 id="chat-tools-title" class="sr-only" data-i18n="chatOptions">Chat options</h2>
      <button type="button" id="pin-chat" class="btn" aria-pressed="false" data-i18n="pin">Pin this chat</button>
      <label class="sr-only" for="chat-project" data-i18n="project">Project</label>
      <select id="chat-project"></select>
      <button type="button" id="delete-chat" class="btn danger" data-i18n="deleteChat">Delete chat</button>
    </div>

    <main id="main" tabindex="-1">
      <div id="thread" tabindex="-1" class="thread">
        <section id="empty" aria-labelledby="greeting">
          <h2 id="greeting" data-i18n="greeting">Hello, friend</h2>
          <p class="lead" data-i18n="tagline">Ask about farming, weather, news and places. Get the answer with its source.</p>
          {/* First run only: one tap switches the whole screen. The labels are the languages' own names, so they are not translated. */}
          <div class="first-lang" id="first-lang" role="group" aria-label={en.language} data-i18n-attr="aria-label:language" hidden>
            <button type="button" class="btn chip" data-first-lang="en" lang="en">English</button>
            <button type="button" class="btn chip" data-first-lang="sn" lang="sn">ChiShona</button>
            <button type="button" class="btn chip" data-first-lang="nd" lang="nd">isiNdebele</button>
          </div>
          <h3 id="try" class="try" data-i18n="tryAsking">Try asking</h3>
          <div class="examples" role="group" aria-label={en.suggestedPrompts} data-i18n-attr="aria-label:suggestedPrompts">
            <button type="button" class="btn chip" data-example data-i18n="example1">When should I plant maize if the rains come late?</button>
            <button type="button" class="btn chip" data-example data-i18n="example2">What is the news on maize prices this week?</button>
            <button type="button" class="btn chip" data-example data-i18n="example3">Where is the nearest market in Masvingo?</button>
          </div>
          <p class="trust"><span data-i18n="wrongNote">{en.wrongNote}</span><span aria-hidden="true"> · </span><a class="footer-link" href="/chat/disclaimer/" data-i18n="privacyLink">{en.privacyLink}</a></p>
        </section>
        <div id="log" role="log" aria-live="polite" aria-relevant="additions"></div>
        <noscript>Shamwari Chat needs JavaScript to run. Your questions go only to the Shamwari API.</noscript>
        {/* The icons the answers are drawn with (render.ts `glyph`): Mzizi's own glyphs, cloned at run time, so no SVG path is ever
            written by hand in the script and none of it adds to the first-load JavaScript. */}
        <template id="glyphs">{(['copy', 'upload', 'clipboard', 'check', 'list', 'search', 'shield', 'sparkles', 'book', 'sparkle', 'chevron-right'] as const).map((n) => <Icon name={n} class="gl" />)}</template>
      </div>

      {/* The prompt box, docked at the bottom. */}
      <div class="dock">
        {/* "A new version is available": Mzizi's toast (a card at the bottom, centred on a phone, at the right from 40rem),
            kept until the person answers. While the page is in view the update waits for them; in the background it
            applies by itself (main.ts, update-reload.ts). */}
        <div id="update-note" class="update-toast" role="status" hidden>
          <p data-i18n="updateReady">{en.updateReady}</p>
          <div class="update-actions">
            <button type="button" id="update-later" class="btn link" data-i18n="updateLater">{en.updateLater}</button>
            <button type="button" id="update-now" class="btn primary" data-i18n="reloadNow">{en.reloadNow}</button>
          </div>
        </div>
        <button type="button" id="jump-latest" class="jump-latest" hidden aria-label={en.jumpLatest} data-i18n-attr="aria-label:jumpLatest"><Icon name="arrow-right" class="i down" /></button>
        <section class="ask" aria-labelledby="ask-title">
          <h2 id="ask-title" class="sr-only" data-i18n="askRegion">Ask a question</h2>
          <form id="composer" class="composer" autocomplete="off">
            {/* Status chips, at the top of the box: offline, offline mode, and which skills are on in this chat. */}
            <div class="status-chips">
              <div id="offline-mode-note" class="status-chip" role="status" hidden>
                <span data-i18n="offlineModeNote">{en.offlineModeNote}</span>
                <button type="button" class="chip-x" aria-label={en.close} data-i18n-attr="aria-label:close"><Icon name="close" class="i chip-x-i" /></button>
              </div>
              <div id="skills-note" class="status-chip skills-note" role="status" hidden><span id="skills-note-text"></span></div>
              <div id="offline" class="status-chip" role="status" hidden>
                <span data-i18n="offlineBanner">{en.offlineBanner}</span>
                <button type="button" class="chip-x" aria-label={en.close} data-i18n-attr="aria-label:close"><Icon name="close" class="i chip-x-i" /></button>
              </div>
            </div>
            <label class="sr-only" for="q" data-i18n="placeholder">Ask a question</label>
            <ul id="attach-list" class="attach-list" hidden aria-label={en.attachments} data-i18n-attr="aria-label:attachments"></ul>
            <textarea id="q" rows="1" enterkeyhint="send" aria-describedby="key-hints" data-i18n-attr="placeholder:placeholder" placeholder="Ask a question"></textarea>
            <div class="composer-bar">
              <button type="button" id="plus" class="bar-icon" aria-haspopup="true" aria-expanded="false" aria-controls="plus-menu" aria-label={en.addTo} data-i18n-attr="aria-label:addTo"><Icon name="plus" class="i" /></button>
              {/* What kind of question this chat asks: General, or Personal while a personal skill is on (then nothing goes to an AI
                  model). It shows the state and opens the skill commands; it never picks a scope (chat/app.ts). */}
              <button type="button" id="mode-chip" class="mode-chip" aria-haspopup="dialog"><span class="sr-only" data-i18n="scopeLabel">{en.scopeLabel}</span><span id="mode-text" data-i18n="skillGeneral">{en.skillGeneral}</span></button>
              <span class="composer-gap"></span>
              <button type="button" id="mic" class="bar-icon" aria-pressed="false" aria-label={en.recordVoice} data-i18n-attr="aria-label:recordVoice"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg></button>
              <button type="submit" id="send" class="send-round" disabled aria-label={en.send} data-i18n-attr="aria-label:send"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg><span class="sr-only" data-i18n="send">{en.send}</span></button>
            </div>
          </form>
          <p id="key-hints" class="key-hints" data-i18n="keyHints">{en.keyHints}</p>
          {/* The "+" menu: Upload a file. Files stay on this device; see chat/attach.ts. */}
          <div id="plus-menu" class="menu plus-menu" popover role="group" aria-label={en.addTo} data-i18n-attr="aria-label:addTo">
            <button type="button" id="plus-upload" class="btn" data-i18n="uploadFile">{en.uploadFile}</button>
          </div>
          <input type="file" id="file-input" multiple hidden />
          <p id="toast" class="toast" role="status"></p>
        </section>
      </div>
    </main>
  </div>
  </div>
  {/* Signed out: a whole screen, and nothing else. With a session the page never shows this. */}
  <main id="auth" class="signin-screen" aria-labelledby="auth-title" hidden>
    <img class="mark" src="/apple-touch-icon.png" alt="" width="48" height="48" />
    <h1 id="auth-title" tabindex="-1" data-i18n="appName">Shamwari Chat</h1>
    <button type="button" id="mukoko-signin" class="btn primary" disabled aria-describedby="mukoko-soon" data-i18n="authMukoko">Sign in with Mukoko</button>
    <p id="mukoko-soon" class="small" data-i18n="authMukokoSoon">Mukoko sign-in is coming soon.</p>
    <p id="signin-failed" class="small bad" role="alert" hidden data-i18n="signInFailed">We could not sign you in. Please try again.</p>
    <p id="signin-offline" class="small" role="status" hidden data-i18n="signinOffline">You are offline. Sign in when you are back online.</p>
    <p id="signin-note" class="small" role="status" hidden></p>
    <a class="footer-link" href="/chat/disclaimer/" data-i18n="disclaimerLink">Disclaimer and privacy</a>
  </main>
  {/* A saved answer, opened from the drawer. */}
  <dialog id="artifact-view" class="sheet" aria-labelledby="artifact-title-view">
    <h2 id="artifact-title-view"></h2>
    <p id="artifact-text" class="artifact-text"></p>
    <ul id="artifact-cites" class="side-list"></ul>
    <div class="row">
      <button type="button" id="artifact-open" class="btn" data-i18n="openChat">Open the chat</button>
      <button type="button" id="artifact-remove" class="btn danger" data-i18n="removeArtifact">Remove</button>
      <button type="button" id="artifact-close" class="btn primary" data-i18n="close">Close</button>
    </div>
  </dialog>
  {/* Settings: a modal (focus held, Esc closes, the page behind is inert). Full screen below 40rem, a centred box above. */}
  <dialog id="settings-dialog" class="settings-dialog" aria-labelledby="settings-title">
    <div class="settings-head">
      <h2 id="settings-title" data-i18n="settings">{en.settings}</h2>
      <button type="button" id="settings-close" class="btn" data-i18n="close">{en.close}</button>
    </div>
    <div class="settings-body">
      <section class="settings-section" aria-labelledby="settings-lang-title">
        <h3 id="settings-lang-title" data-i18n="language">Language</h3>
        <div id="lang" class="radio-group" role="radiogroup" aria-labelledby="settings-lang-title" aria-describedby="review"></div>
        <p id="review" class="notice" data-review-note hidden data-i18n="reviewNote">This language is a draft and still needs review by a native speaker.</p>
      </section>
      <section class="settings-section" aria-labelledby="settings-conn-title">
        <h3 id="settings-conn-title" data-i18n="settingsConnection">{en.settingsConnection}</h3>
        <button type="button" id="offline-mode" role="switch" aria-checked="false" class="btn offline-switch">
          <span data-i18n="offlineMode">{en.offlineMode}</span>
          <span class="offline-state" aria-hidden="true" data-i18n="offlineModeOff">{en.offlineModeOff}</span>
        </button>
        <p class="settings-hint" data-i18n="offlineModeHelp">{en.offlineModeHelp}</p>
      </section>
      <section class="settings-section" aria-labelledby="settings-data-title">
        <h3 id="settings-data-title" data-i18n="settingsData">{en.settingsData}</h3>
        <div class="row">
          <button type="button" id="delete-history" class="btn danger" data-i18n="deleteHistory">Delete history</button>
          <button type="button" id="signout" class="btn" hidden data-i18n="authDevClear">Remove key</button>
          <button type="button" id="install" class="btn" hidden data-i18n="install">Install app</button>
        </div>
      </section>
      <section class="settings-section" aria-labelledby="settings-about-title">
        <h3 id="settings-about-title" data-i18n="about">{en.about}</h3>
        <a class="side-row" href="/chat/disclaimer/"><span data-i18n="disclaimerLink">{en.disclaimerLink}</span></a>
        <a class="side-row" href="https://platform.nyuchi.com" target="_blank" rel="noopener"><span data-i18n="useApi">Use the API</span><span class="sr-only" data-i18n="opensNewTab">(opens in a new tab)</span></a>
        <p class="version-line" data-current-version-line hidden><span data-i18n="version">Version</span> <span data-current-version></span></p>
        {/* Shown once the service worker is registered (main.ts); without one there is nothing to update. */}
        <button type="button" id="check-update" class="btn" hidden data-i18n="checkUpdates">{en.checkUpdates}</button>
        <p class="note" role="status">
          <span data-update-status="checking" hidden data-i18n="checkingUpdates">{en.checkingUpdates}</span>
          <span data-update-status="latest" hidden data-i18n="upToDate">{en.upToDate}</span>
          <span data-update-status="updating" hidden data-i18n="updating">{en.updating}</span>
          <span data-update-status="failed" hidden data-i18n="updateFailed">{en.updateFailed}</span>
        </p>
      </section>
    </div>
  </dialog>
  {/* Signing out of a Mukoko account: the messages stay on this device unless the person also chooses to delete them. */}
  <dialog id="signout-dialog" class="sheet" aria-labelledby="signout-title">
    <h2 id="signout-title" data-i18n="signOutTitle">{en.signOutTitle}</h2>
    <p data-i18n="signOutKept">{en.signOutKept}</p>
    <p class="row">
      <input type="checkbox" id="signout-delete" />
      <label for="signout-delete" data-i18n="signOutAlsoDelete">{en.signOutAlsoDelete}</label>
    </p>
    <p class="note" data-i18n="signOutNotEncrypted">{en.signOutNotEncrypted}</p>
    <div class="row">
      <button type="button" id="signout-cancel" class="btn" data-i18n="signOutCancel">{en.signOutCancel}</button>
      <button type="button" id="signout-confirm" class="btn primary" data-i18n="signOut">{en.signOut}</button>
    </div>
  </dialog>
  <script>
    import '../../../src/chat/main';
  </script>
</body>
</html>
